# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local data — never commit real participant data
data/local/

# Generated by `dwell.py deploy`. Contains this course's secret key and
# a bundle of the server — specific to one installation, never shared.
deploy/
app/.env

# Databases. The course database lives in data/local/ and holds participant
# location data; it must never reach a repository.
*.db
*.sqlite
*.sqlite3

# Node / Expo (mobile app, added in a later stage)
node_modules/
.expo/
dist/
*.log

# Secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.vscode/
.idea/
